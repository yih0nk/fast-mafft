+			}
+		}
+		if( upgstat ) { double t_ = upg_now(); ustscan += t_ - ustt; ustt = t_; }
+		if( u.nfull )
+		{
+			int par = parallel && (long long)u.nfull * u.nact >= 4 * U9_PARMIN;
