+		w.midw = msf_calloc( lgth2+2, sizeof( double ) );
+		w.midm = msf_calloc( lgth2+2, sizeof( double ) );
+		w.midn = msf_calloc( lgth2+2, sizeof( double ) );
+		w.jumpbacki = msf_calloc( lgth2+2, sizeof( int ) );
+		w.jumpbackj = msf_calloc( lgth2+2, sizeof( int ) );
