+/* work/prog2: per-thread arena for Falign's per-call row buffers (result1/2 and tmpres1/2, clus x
+   alloclen each, used to be calloc'ed row by row and freed on every call).  Every row is written
+   with a terminator before it is read (tmpres by strncpy + explicit 0, result by result[j][0] = 0
+   and terminated appends); the first byte of each row is still set to 0. */
+static TLS char *fa_blk = NULL;
+static TLS size_t fa_cap = 0;
+static TLS char **fa_rows = NULL;
+static TLS int fa_rowcap = 0;
+
+/* work/v10w: a small shared pool for the large per-thread arenas (Falign's rows here, the member-row
+   copies in treebasethread).  Every thread used to keep its arenas, grown to the largest step it ever
+   ran; on the critical chain of a large set the big steps run one after another on whichever thread is
+   free, so every thread ended up holding arenas for the largest groups: peak RSS ~3x the baseline's at
+   32 threads on SARS-CoV-2 sets (the original allocates these buffers per call and frees them).  Now a
+   thread gives an arena of at least BIGPOOL_MIN bytes back when its step ends, and the next step, on
+   any thread, takes the best-fitting pooled block (or the largest one, grown with realloc).  So the
+   large blocks in existence are about those of the running steps plus at most BIGPOOL_MAX pooled ones
+   (two: on the critical chain a step gives back its two arenas and the next step takes them).
+   The contents of an arena never matter (every row is written before it is read). */
+#define BIGPOOL_MAX 2
+#ifdef enablemultithread
+static pthread_mutex_t bigpool_mutex = PTHREAD_MUTEX_INITIALIZER;
+#endif
+static char *bigpool_blk[BIGPOOL_MAX];
+static size_t bigpool_cap[BIGPOOL_MAX];
+static int bigpool_n = 0;
+char *bigpool_take( size_t need, size_t *cap ) // a block of at least need bytes (its size in *cap), or NULL
+{
+	char *b = NULL;
+	int k, best = -1;
+#ifdef enablemultithread
+	pthread_mutex_lock( &bigpool_mutex );
+#endif
+	for( k=0; k<bigpool_n; k++ ) if( bigpool_cap[k] >= need && ( best < 0 || bigpool_cap[k] < bigpool_cap[best] ) ) best = k;
+	if( best < 0 ) for( k=0; k<bigpool_n; k++ ) if( best < 0 || bigpool_cap[k] > bigpool_cap[best] ) best = k; // none fits: the largest, grown
+	if( best >= 0 )
+	{
+		b = bigpool_blk[best]; *cap = bigpool_cap[best];
+		bigpool_n--; bigpool_blk[best] = bigpool_blk[bigpool_n]; bigpool_cap[best] = bigpool_cap[bigpool_n];
+	}
+#ifdef enablemultithread
+	pthread_mutex_unlock( &bigpool_mutex );
+#endif
+	if( b && *cap < need )
+	{
+		char *nb = realloc( b, need + need / 2 );
+		if( nb == NULL ) { free( b ); return( NULL ); }
+		b = nb; *cap = need + need / 2;
+	}
+	return( b );
+}
+void bigpool_put( char *b, size_t cap ) // gives a block back (or frees it, or a smaller pooled one, when the pool is full)
+{
+	int k, small = -1;
+	char *f = NULL;
+	if( b == NULL ) return;
+#ifdef enablemultithread
+	pthread_mutex_lock( &bigpool_mutex );
+#endif
+	if( bigpool_n < BIGPOOL_MAX ) { bigpool_blk[bigpool_n] = b; bigpool_cap[bigpool_n] = cap; bigpool_n++; }
+	else
+	{
+		for( k=0; k<bigpool_n; k++ ) if( small < 0 || bigpool_cap[k] < bigpool_cap[small] ) small = k;
+		if( bigpool_cap[small] < cap ) { f = bigpool_blk[small]; bigpool_blk[small] = b; bigpool_cap[small] = cap; }
+		else f = b;
+	}
+#ifdef enablemultithread
+	pthread_mutex_unlock( &bigpool_mutex );
+#endif
+	free( f );
+}
+void bigpool_free( void ) // at the end of a pass
+{
+	int k;
+#ifdef enablemultithread
+	pthread_mutex_lock( &bigpool_mutex );
+#endif
+	for( k=0; k<bigpool_n; k++ ) free( bigpool_blk[k] );
+	bigpool_n = 0;
+#ifdef enablemultithread
+	pthread_mutex_unlock( &bigpool_mutex );
+#endif
+}
+void Falign_release( void ) // work/v10w: when a step ends, a large row arena goes to the pool
+{
+	if( fa_cap >= BIGPOOL_MIN ) { bigpool_put( fa_blk, fa_cap ); fa_blk = NULL; fa_cap = 0; }
+}
+
+static void Falign_rows( int clus1, int clus2, int alloclen, char ***r1, char ***r2, char ***t1, char ***t2 )
+{
+	int n = 2 * ( clus1 + clus2 ), i;
+	size_t need = (size_t)n * alloclen;
+	char **p;
+	if( need > fa_cap && fa_blk == NULL && need >= BIGPOOL_MIN ) // work/v10w: a pooled block
+	{
+		size_t c = 0;
+		char *b = bigpool_take( need, &c );
+		if( b ) { fa_blk = b; fa_cap = c; }
+	}
+	if( need > fa_cap )
+	{
+#ifdef PROGTIMING
+		pt_acc[43] += 1.0; // work/v8s: arena reallocations
+#endif
+		/* work/v8s: realloc instead of free + malloc (the content does not matter): for a large
+		   (mmapped) block glibc moves the pages with mremap, so the pages already touched need not be
+		   faulted in again along the critical chain, where the arena grows every few steps */
+		fa_cap = need + need / 2;
+		{
+			char *nb = realloc( fa_blk, fa_cap );
+			if( nb == NULL ) ErrorExit( "Cannot allocate the work area in Falign.\n" );
+			fa_blk = nb;
+		}
+	}
+	if( n + 4 > fa_rowcap )
+	{
+		free( fa_rows );
+		fa_rowcap = n + 4 + ( n + 4 ) / 2;
+		fa_rows = malloc( fa_rowcap * sizeof( char * ) );
+		if( fa_rows == NULL ) ErrorExit( "Cannot allocate the work area in Falign.\n" );
+	}
+	p = fa_rows;
+	*r1 = p; for( i=0; i<clus1; i++ ) *p++ = fa_blk + (size_t)( i ) * alloclen; *p++ = NULL;
+	*r2 = p; for( i=0; i<clus2; i++ ) *p++ = fa_blk + (size_t)( clus1 + i ) * alloclen; *p++ = NULL;
+	*t1 = p; for( i=0; i<clus1; i++ ) *p++ = fa_blk + (size_t)( clus1 + clus2 + i ) * alloclen; *p++ = NULL;
+	*t2 = p; for( i=0; i<clus2; i++ ) *p++ = fa_blk + (size_t)( 2*clus1 + clus2 + i ) * alloclen; *p++ = NULL;
+	for( i=0; i<n; i++ ) fa_blk[(size_t)i*alloclen] = 0;
+}
+
+static void Falign_rows_free( void )
+{
+	free( fa_blk ); fa_blk = NULL; fa_cap = 0;
+	free( fa_rows ); fa_rows = NULL; fa_rowcap = 0;
+}
+
+void Falign_trim( size_t keep ) // work/largen: give a large row arena back (see A__align_trim)
+{
+	if( fa_cap > keep ) { free( fa_blk ); fa_blk = NULL; fa_cap = 0; }
+}
+
+/* work/prog3: the segments of a Falign call in parallel.  After the anchors are fixed, every
+   segment between two cut points is aligned on its own: its inputs are the original columns
+   cut1[i]..cut1[i+1]-1 (and cut2[...]) of seq1/seq2 plus the gap states at the cut points
+   (getkyokaigap reads the original rows), and its output is appended to the result in segment order.
+   So segments can be aligned by any thread in any order, each into its own buffers, and then
+   appended in order: every row of the result gets the same bytes as in the sequential loop.  The
+   aligners keep their working state per thread (TLS), the totalscore sum is formed in segment order.
+   Used for alg 'A' without constraint/codon options, when idle helper threads exist.
+   work/v10w: the segments' buffers are the rows of the per-thread arena (tmpres1/tmpres2, segment i
+   at offset soff[i] of every row, room for its two lengths + terminator), not a separate block; and
+   the result is concatenated straight into seq1/seq2, row by row with idle helpers, once every
+   segment is done (nothing reads seq1/seq2 after that), instead of appending into result1/result2
+   serially and copying those back: the rows of seq1/seq2 get the bytes the final strcpy gives them. */
+typedef struct
+{
+	char **seq1, **seq2;
+	int clus1, clus2, nseg, alloclen;
+	const int *cut1, *cut2;
+	double **n_dynamicmtx;
+	double *eff1, *eff2;
+	char **t1, **t2;        // the arena rows; segment i in t1[j]+soff[i], t2[j]+soff[i]
+	size_t *soff;
+	char *sg;               // per segment: sgap1, sgap2, egap1, egap2 (4 consecutive blocks)
+	double *score;
+	int *olen1, *olen2;     // per segment: its output length (row 0)
+	int *doff1, *doff2;     // per segment: where its output goes in the result rows
+	int total1, total2;
+	int *ord;               // work/v10w: the segments in the order they are claimed (largest DP first)
+} psegctx_t;
+
+static void pseg_body( void *vctx, int lo, int hi )
+{
+	psegctx_t *c = (psegctx_t *)vctx;
+	int i, j;
+	int clus1 = c->clus1, clus2 = c->clus2;
+	char **tmpres1 = malloc( sizeof( char * ) * ( clus1 + 1 ) ), **tmpres2 = malloc( sizeof( char * ) * ( clus2 + 1 ) );
+	if( !tmpres1 || !tmpres2 ) ErrorExit( "Cannot allocate the segment rows in Falign.\n" );
+	int ii;
+	for( ii=lo; ii<hi; ii++ )
+	{
+		const int *cut1 = c->cut1, *cut2 = c->cut2;
+		int headgp, tailgp;
+		i = c->ord[ii];
+		char *sgap1 = c->sg + (size_t)i * 2 * ( clus1 + clus2 ), *sgap2 = sgap1 + clus1, *egap1 = sgap2 + clus2, *egap2 = egap1 + clus1;
+		int len1 = cut1[c->nseg], len2 = cut2[c->nseg];
+		double dumdb = 0.0;
+		for( j=0; j<clus1; j++ ) tmpres1[j] = c->t1[j] + c->soff[i];
+		for( j=0; j<clus2; j++ ) tmpres2[j] = c->t2[j] + c->soff[i];
+		tmpres1[clus1] = tmpres2[clus2] = NULL;
+		if( i == 0 ) headgp = outgap; else headgp = 1;
+		if( i == c->nseg-1 ) tailgp = outgap; else tailgp = 1;
+		if( cut1[i] )
+			getkyokaigap( sgap1, c->seq1, cut1[i]-1, clus1 );
+		else
+			for( j=0; j<clus1; j++ ) sgap1[j] = 'o';
+		if( cut2[i] )
+			getkyokaigap( sgap2, c->seq2, cut2[i]-1, clus2 );
+		else
+			for( j=0; j<clus2; j++ ) sgap2[j] = 'o';
+		if( cut1[i+1] != len1 )
+			getkyokaigap( egap1, c->seq1, cut1[i+1], clus1 );
+		else
+			for( j=0; j<clus1; j++ ) egap1[j] = 'o';
+		if( cut2[i+1] != len2 )
+			getkyokaigap( egap2, c->seq2, cut2[i+1], clus2 );
+		else
+			for( j=0; j<clus2; j++ ) egap2[j] = 'o';
+		for( j=0; j<clus1; j++ )
+		{
+			strncpy( tmpres1[j], c->seq1[j]+cut1[i], cut1[i+1]-cut1[i] );
+			tmpres1[j][cut1[i+1]-cut1[i]] = 0;
+		}
+		for( j=0; j<clus2; j++ )
+		{
+			strncpy( tmpres2[j], c->seq2[j]+cut2[i], cut2[i+1]-cut2[i] );
+			tmpres2[j][cut2[i+1]-cut2[i]] = 0;
+		}
+		if( clus1 == 1 && clus2 == 1 )
+			c->score[i] = G__align11( c->n_dynamicmtx, tmpres1, tmpres2, c->alloclen, headgp, tailgp );
+		else
