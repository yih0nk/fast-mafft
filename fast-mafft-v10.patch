+	{
+		char *t1 = msf_alloc( ( lgth1 > 0 ? lgth1 : 0 ) + lgth2 + 2 ), *t2 = msf_alloc( ( lgth1 > 0 ? lgth1 : 0 ) + lgth2 + 2 );
