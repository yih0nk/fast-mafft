+		if( t->par ) pthread_mutex_lock( &t->mu );
+		t->nodes[id].leaf = 1; t->nodes[id].t1 = t1; t->nodes[id].t2 = t2; t->nodes[id].tlen = n; t->nodes[id].value = 0.0;
