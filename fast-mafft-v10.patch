+			i = candlist[x];
+			if( u9_listscan( &u, i, &m, &j ) )
+			{
+				mindisfrom[i] = m;
+				nearest[i] = j;
+				u.nlisthit++;
+			}
+			else
+			{
+				u.full[u.nfull] = i;
+				u.fullpos[u.nfull] = u9_findpos( u.act, u.nact, i );
