+		// update loop
+		u.im = im;
+		u.jm = jm;
+		for( q=u.lastq; !u.alive[u.act[q]] || u.act[q] == jm; q-- ) ; // the last active node once jm is gone
+		u.last = u.act[q];
+		if( upgstat ) u.nstrided += 2 * (long long)u9_findpos( u.act, u.nact, im ) + ( u9_findpos( u.act, u.nact, jm ) - u9_findpos( u.act, u.nact, im ) );
