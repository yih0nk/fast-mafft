+static void *upg_worker( void *arg )
+{
+	upg_t *u = (upg_t *)arg;
+	unsigned long long w;
+	int spins = 0;
+	for( ;; )
+	{
+		w = __atomic_load_n( &u->next, __ATOMIC_ACQUIRE );
+		if( UPG_KIND( w ) == UPG_KIND_QUIT ) break;
+		if( UPG_IDX( w ) < UPG_NCH( w ) )
+		{
+			upg_claim( u );
+			spins = 0;
+			continue;
+		}
+		if( ++spins < 20000 ) upg_relax();
+		else sched_yield();
+	}
+	return( NULL );
+}
