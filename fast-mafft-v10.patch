+typedef struct
+{
+	int nseq;
+	double **eff;
+	int *act, nact;
+	double *mindisfrom;
+	int *nearest;
+	double (*clusterfunc)(double,double);
+	int im, jm;
+	int chunksize;
+	/* update phase, per chunk */
+	int *cand;              /* the candidates of a chunk are stored from its first act[] index */
+	int *ccnt;
+	double *cv; int *cj;    /* partial minimum for mindisfrom[im] */
+	/* recheck phase */
