+void alignableReagion_prep_free( void )
+{
+	free( arp_p1 ); arp_p1 = NULL; arp_cap1 = 0;
+	free( arp_p2 ); arp_p2 = NULL; arp_cap2 = 0;
+	free( arp_stra ); arp_stra = NULL; arp_stracap = 0;
+	free( arp_tmp ); arp_tmp = NULL; arp_tmpcap = 0; // work/v8s
