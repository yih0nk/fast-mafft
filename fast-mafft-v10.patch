+	{
+		uint16_t *lp = s->lp + s->off[i], *lc = s->lc + s->off[i];
+		m = 0;
+		if( *p != -1 ) for( ; ( point = *p ) != END_OF_VEC; p++ ) if( cnt[point]++ == 0 ) lp[m++] = point;
