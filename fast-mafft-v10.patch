+static size_t pseg_rowlen( int nseg, const int *cut1, const int *cut2 ) // the arena row length Falign_psegs needs
+{
+	size_t n = 0;
+	int i;
+	for( i=0; i<nseg; i++ ) n += ( cut1[i+1]-cut1[i] ) + ( cut2[i+1]-cut2[i] ) + 2;
+	return( n );
+}
