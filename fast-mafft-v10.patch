+static int sextet_ovcorr( sextetfast_t *s, int i, int j )
+{
+	int a = 0, b = 0, v = 0;
+	int na = s->ovn[i], nb = s->ovn[j];
+	int *pa = s->ovp[i], *pb = s->ovp[j], *ca = s->ovc[i], *cb = s->ovc[j];
+	while( a < na && b < nb )
+	{
+		if( pa[a] < pb[b] ) a++;
+		else if( pa[a] > pb[b] ) b++;
+		else
+		{
+			v += MIN( ca[a], cb[b] ) - 255;
+			a++; b++;
+		}
+	}
+	return( v );
+}
