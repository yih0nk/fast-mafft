+static void upg_relax( void )
+{
+#if defined(__aarch64__) || defined(__arm64__)
+	__asm__ __volatile__( "yield" );
+#elif defined(__x86_64__) || defined(__i386__)
+	__asm__ __volatile__( "pause" );
+#endif
